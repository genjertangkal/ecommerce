# ==============================================================================
# Generated and machine-local files
# ==============================================================================
# Companion to .bazelignore. The two serve different purposes and are not
# redundant: .bazelignore keeps Bazel from traversing a directory as a package,
# while this keeps generated output out of version control. A path usually
# belongs in both, and the lists are kept in step on purpose.
# ==============================================================================

# -----------------------------------------------------------------------------
# Bazel convenience symlinks
# -----------------------------------------------------------------------------
# /bazel-bin, /bazel-out, /bazel-testlogs and /bazel-<workspace> are symlinks
# Bazel creates in the workspace root. The leading slash anchors the pattern to
# the root: without it, a real source directory named `bazel-something` would be
# ignored too.
#
# This also covers /bazel-ecommerce, whose name depends on the workspace rather
# than being fixed, which is why the four names are not listed individually.
/bazel-*

# Bazel's per-user rc directory (--blprc, --noworkspace_rc and friends land
# here) and the machine-local overrides that .bazelrc try-imports at the end.
# Deliberately NOT committed: they are per-developer and per-machine.
.bazel/
user.bazelrc
local.bazelrc

# -----------------------------------------------------------------------------
# Build and packaging output
# -----------------------------------------------------------------------------
# Mirrors the "Build and packaging output" section of .bazelignore.
/dist/
/out/
/tmp/
/temp/

# -----------------------------------------------------------------------------
# Test and profiling output
# -----------------------------------------------------------------------------
# Mirrors the "Test and profiling output" section of .bazelignore.
/test-results/
/coverage/
/logs/

# Go coverage and profiling artefacts.
*.out
*.profraw
*.test

# -----------------------------------------------------------------------------
# Third-party dependency trees
# -----------------------------------------------------------------------------
# Mirrors .bazelignore. Vendored code that is meant to be committed belongs in
# third-party/, not in a top-level vendor/.
/node_modules/
/vendor/
__pycache__/

# -----------------------------------------------------------------------------
# Version control and editor state
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# OS metadata
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Generated documentation
# -----------------------------------------------------------------------------
# Mirrors the "Generated documentation" section of .bazelignore.
/docs/_build/
/site/

# -----------------------------------------------------------------------------
# Locally installed agent tooling
# -----------------------------------------------------------------------------
# .agents/ holds skill documents installed onto this machine, not source of the
# repository: 850+ markdown files with no relationship to the build, and no
# BUILD file, so Bazel never treats them as packages. Tracked or not, they are
# regenerated by whatever installs them.
#
# skills-lock.json is deliberately NOT ignored: it is the lockfile for that
# tooling, in the same way MODULE.bazel.lock is the lockfile for this one, and it
# is what makes the installed set reproducible.
.agents/

