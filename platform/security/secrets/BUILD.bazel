# ==============================================================================
# Secrets capability
# ==============================================================================
# `go_lib` with the capability tags spelled out, rather than the `secrets_lib`
# macro. The macro expands to exactly this target, and every check in
# //bazel/aspects:aspects.bzl keys on the tags rather than the rule kind, so
# nothing observable changes.
#
# `secrets_lib` cannot be indexed by Gazelle: `config.KindMap` is keyed by the
# builtin kind, so only one macro name per builtin is resolvable and
# `secrets_lib` would displace `go_lib`. Gazelle would then be unable to map an
# import of this package to a label, silently delete the `deps` entry from
# importing packages and shell out to `go` instead. See the Gazelle section in
# //BUILD.bazel.
# ==============================================================================

load("//build:macros.bzl", "go_lib", "go_test_lib")

go_lib(
    name = "secrets",
    srcs = ["secrets.go"],
    importpath = "github.com/ecommerce/platform/security/secrets",
    tags = [
        "backend=memory",
        "capability=secrets",
        "layer=platform",
        "rotate_interval_hours=24",
    ],
    visibility = ["//visibility:public"],
)

go_test_lib(
    name = "secrets_test",
    size = "small",
    srcs = ["secrets_test.go"],
    embed = [":secrets"],
)
