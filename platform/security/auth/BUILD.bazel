# ==============================================================================
# Auth capability
# ==============================================================================
# `go_lib` with the capability tags spelled out, rather than the `auth_lib` macro.
# The macro expands to exactly this target, and every check in
# //bazel/aspects:aspects.bzl keys on the tags rather than the rule kind, so
# nothing observable changes.
#
# `auth_lib` cannot be indexed by Gazelle: `config.KindMap` is keyed by the
# builtin kind, so only one macro name per builtin is resolvable and `auth_lib`
# would displace `go_lib`. Gazelle would then be unable to map an import of this
# package to a label, silently delete the `deps` entry from importing packages
# and shell out to `go` instead. See the Gazelle section in //BUILD.bazel.
# ==============================================================================

load("//build:macros.bzl", "go_lib", "go_test_lib")

go_lib(
    name = "auth",
    srcs = [
        "auth.go",
        "claims.go",
    ],
    importpath = "github.com/ecommerce/platform/security/auth",
    tags = [
        "capability=auth",
        "jwt_alg=RS256",
        "layer=platform",
        "providers=api-key,oauth2,openid-connect",
    ],
    visibility = ["//visibility:public"],
)

go_test_lib(
    name = "auth_test",
    size = "small",
    srcs = ["auth_test.go"],
    embed = [":auth"],
)
