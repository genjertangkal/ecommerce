load("//build:macros.bzl", "go_lib", "go_test_lib")

go_lib(
    name = "handler",
    srcs = [
        "actor.go",
        "product.go",
    ],
    importpath = "github.com/ecommerce/services/commerce/internal/handler",
    tags = [
        "layer=internal",
        "team=commerce",
    ],
    # //services/commerce:__subpackages__ allows this package and its siblings
    # (handler -> service -> store) but nothing else in the repository.
    # //visibility:private would also work only if all three targets lived in
    # one Bazel package, which they do not.
    #
    # Other teams consume the proto contract instead, which is what keeps this
    # service independently deployable.
    visibility = ["//services/commerce:__subpackages__"],
    deps = [
        "//platform/observability/logging",
        "//services/commerce/internal/service",
        "//services/commerce/internal/store",
    ],
)

go_test_lib(
    name = "handler_test",
    size = "small",
    srcs = ["product_test.go"],
    embed = [":handler"],
    deps = [
        "//services/commerce/internal/service",
        "//services/commerce/internal/store",
    ],
)
